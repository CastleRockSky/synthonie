{
  "name": "synthonie",
  "productName": "Synthonie",
  "private": true,
  "version": "0.2.1",
  "description": "A simple, growable soundscape and music tool for making RPG game audio.",
  "author": "Dave Coles",
  "repository": {
    "type": "git",
    "url": "https://github.com/CastleRockSky/synthonie.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/start.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "release": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish always"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wasm-media-encoders": "^0.7.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
