{
  "name": "zeke-synth",
  "productName": "Zeke Synth",
  "private": true,
  "version": "0.1.0",
  "description": "A simple, growable soundscape and music tool for making RPG game audio.",
  "author": "Dave Coles",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/start.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.davecoles.zekesynth",
    "productName": "Zeke Synth",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "zekeproj",
        "name": "Zeke Synth project",
        "description": "Zeke Synth project",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Zeke Synth",
      "artifactName": "Zeke-Synth-Setup-${version}.${ext}"
    }
  }
}
